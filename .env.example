# Root
NODE_ENV=development

# API
# Em produção use Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public
# Use um segredo longo e aleatório em produção (mín. 8 caracteres)
JWT_SECRET=change-me

# CORS: origens permitidas separadas por vírgula (recomendado em produção).
# Se vazio, o CORS libera todas as origens.
# Ex.: ALLOWED_ORIGINS=https://seu-front.onrender.com,https://seu-front.web.app
ALLOWED_ORIGINS=

# Conta do dono do painel (semeada no primeiro start).
# Defina SEED_OWNER_ON_START=false se não quiser semear.
SEED_OWNER_ON_START=true
OWNER_NAME=Aarleyzin
OWNER_EMAIL=aarleyzin@meupainel.app
# Defina uma senha forte em produção (não use o padrão do código).
OWNER_PASSWORD=troque-esta-senha

# Web
VITE_API_URL=http://localhost:3333
